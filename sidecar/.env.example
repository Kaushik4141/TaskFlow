# =====================================================================
# TaskFlow MCP - Environment Variables Configuration
# Copy this file to .env or sidecar/.env and fill in your Supabase keys
# =====================================================================

# 1. Supabase Project URL (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase API Key (Anon Public Key for client access, or Service Role Key for background sync)
SUPABASE_KEY=your-supabase-anon-or-service-key

# 3. Optional: Override path to TaskFlow Obsidian Vault
# TASKFLOW_VAULT=C:\Users\YourUsername\Documents\ObsidianVault

# 4. Optional: Override path to TaskFlow SQLite Database
# TASKFLOW_DB=C:\Users\YourUsername\AppData\Roaming\com.taskflow.desktop\taskflow.sqlite
